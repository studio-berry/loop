{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/studio-berry/loupe/schema/lifecycle-trace-v1.json",
  "title": "Loupe deterministic lifecycle trace",
  "type": "object",
  "required": [
    "schema_kind",
    "schema_version",
    "seed",
    "initial_artifact_digest",
    "commands",
    "expected_invariants",
    "observed_result",
    "shrink_history"
  ],
  "properties": {
    "schema_kind": { "const": "loupe-lifecycle-trace" },
    "schema_version": { "const": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "initial_artifact_digest": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "kind"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "kind": {
            "enum": ["open", "render-preflight", "cancel", "replace-revision", "save-reopen", "rollback", "close"]
          },
          "argument": { "type": ["string", "integer", "null"] }
        },
        "additionalProperties": false
      }
    },
    "expected_invariants": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_result": { "type": "string", "minLength": 1 },
    "shrink_history": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    }
  },
  "additionalProperties": false
}
