{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/studio-berry/loupe/schema/resource-envelope-manifest-v1.json",
  "title": "Loupe resource envelope workload manifest",
  "type": "object",
  "required": ["schema_kind", "schema_version", "corpus", "selection", "examples"],
  "properties": {
    "schema_kind": { "const": "loupe-resource-envelope" },
    "schema_version": { "const": 1 },
    "corpus": {
      "type": "object",
      "required": ["name", "root", "summary_sha256", "corpus_digest", "total_examples"],
      "properties": {
        "name": { "const": "DIV2K" },
        "root": { "type": "string", "minLength": 1 },
        "summary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "corpus_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "total_examples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "selection": {
      "type": "object",
      "required": ["seed", "requested_count", "actual_count", "ordering"],
      "properties": {
        "seed": { "type": "integer" },
        "requested_count": { "type": "integer", "minimum": 1 },
        "actual_count": { "type": "integer", "minimum": 1 },
        "ordering": { "const": "example-id" }
      },
      "additionalProperties": true
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "split", "source", "sample_index", "pair_dir", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "split": { "enum": ["train", "valid"] },
          "source": { "type": "string", "minLength": 1 },
          "sample_index": { "type": "integer", "minimum": 0 },
          "pair_dir": { "type": "string", "minLength": 1 },
          "files": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
