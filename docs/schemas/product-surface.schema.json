{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-berry.github.io/loupe/schemas/product-surface.schema.json",
  "title": "Loupe product-surface manifest",
  "description": "The machine-readable product disposition and release inventory for ADR-005.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adr", "profiles", "surfaces", "packaging", "cli", "shell_contract"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "adr": { "type": "string", "const": "docs/adr/adr-005-product-surface-pruning-classification.md" },
    "profiles": {
      "type": "array",
      "prefixItems": [
        { "const": "developer" },
        { "const": "loupe-release" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "packaging": { "$ref": "#/$defs/packaging" },
    "cli": { "$ref": "#/$defs/cli" },
    "shell_contract": { "const": "docs/loupe-shell.json" }
  },
  "$defs": {
    "profileState": { "enum": ["present", "absent"] },
    "disposition": {
      "enum": ["KEEP", "ADVANCED", "CLI-ONLY", "ABSORB", "HIDE", "OPEN", "STOP-SHIPPING", "REMOVE"]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "disposition", "owner", "rationale", "profiles", "validation_evidence", "follow_up_issue"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "kind": { "enum": ["application", "developer-tool", "plugin", "workspace", "packaging"] },
        "artifact": { "type": ["string", "null"] },
        "artifact_scope": { "enum": ["install", "build", "none"] },
        "disposition": { "$ref": "#/$defs/disposition" },
        "owner": { "type": ["string", "null"] },
        "rationale": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["developer", "loupe-release"],
          "properties": {
            "developer": { "$ref": "#/$defs/profileState" },
            "loupe-release": { "$ref": "#/$defs/profileState" }
          }
        },
        "replacement_surface": { "type": ["string", "null"] },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "validation_evidence": { "type": "string", "minLength": 1 },
        "follow_up_issue": { "type": ["integer", "null"], "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "OPEN" } } },
          "then": {
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "follow_up_issue": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "profileFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["developer", "loupe-release"],
      "properties": {
        "developer": { "type": "array", "items": { "type": "string" } },
        "loupe-release": { "type": "array", "items": { "type": "string" } }
      }
    },
    "packaging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktop_entries", "appx_applications"],
      "properties": {
        "desktop_entries": { "$ref": "#/$defs/profileFiles" },
        "appx_applications": { "$ref": "#/$defs/profileFiles" },
        "loupe_launcher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "file_associations"],
          "properties": {
            "executable": { "const": "LoupeEditor" },
            "file_associations": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_command", "capability_field", "required_build_capabilities"],
      "properties": {
        "discovery_command": { "const": "PdfTool capabilities --console-format json" },
        "capability_field": { "const": "build_capabilities" },
        "required_build_capabilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
