{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-berry.github.io/loupe/schemas/loupe-shell.schema.json",
  "title": "Loupe shell contract",
  "description": "Non-visual application-shell contract for issue #193.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "gui_status",
    "shell_surface",
    "ui_foundation",
    "workspaces",
    "state_invariants",
    "status_contract",
    "action_policy",
    "plugin_action_policy",
    "legacy_surface_disposition"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "issue": { "type": "integer", "const": 193 },
    "gui_status": {
      "type": "string",
      "enum": ["gated-by-quick-admission", "quick-admitted"]
    },
    "shell_surface": { "type": "string", "const": "LoupeEditor" },
    "ui_foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "decision_issue", "decision_status"],
      "properties": {
        "candidate": { "type": "string", "const": "Qt Quick Controls" },
        "decision_issue": { "type": "integer", "const": 178 },
        "decision_status": {
          "type": "string",
          "enum": ["pending", "accepted", "accepted-with-admission-gates", "rejected"]
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest_surface", "preserves"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["document", "preflight", "production-preview", "pages", "inspect", "fix", "compare"]
          },
          "manifest_surface": { "type": "string", "pattern": "^loupe-[a-z0-9-]+$" },
          "preserves": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "state_invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "production", "preflight"],
      "properties": {
        "document": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "production": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "preflight": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "action_policy": { "type": "string", "const": "docs/loupe-shell-actions.json" },
    "plugin_action_policy": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/plugin_policy" }
    },
    "legacy_surface_disposition": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": { "$ref": "#/$defs/legacy_surface" }
    }
  },
  "$defs": {
    "plugin_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin",
        "disposition",
        "target",
        "owner",
        "replacement_target",
        "required_test",
        "evidence_artifact",
        "deletion_condition"
      ],
      "properties": {
        "plugin": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": ["KEEP", "ADVANCED", "ABSORB", "HIDE", "OPEN", "STOP-SHIPPING"]
        },
        "target": {
          "enum": ["Document", "Preflight", "Production", "Inspect", "Fix", "Pages", "Compare", "Advanced"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "replacement_target": { "type": ["string", "null"] },
        "required_test": { "type": "string", "minLength": 1 },
        "evidence_artifact": { "type": "string", "minLength": 1 },
        "deletion_condition": { "type": "string", "minLength": 1 },
        "follow_up_issue": { "type": "integer" }
      }
    },
    "legacy_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition",
        "owner",
        "replacement_target",
        "required_test",
        "evidence_artifact",
        "deletion_condition",
        "rationale"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/\\\\]+/.+\\.ui$" },
        "disposition": {
          "enum": ["MIGRATE", "CONSOLIDATE", "HEADLESS", "RETIRE"]
        },
        "owner": { "type": "string", "minLength": 1 },
        "replacement_target": { "type": ["string", "null"] },
        "required_test": { "type": "string", "minLength": 1 },
        "evidence_artifact": { "type": "string", "minLength": 1 },
        "deletion_condition": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
