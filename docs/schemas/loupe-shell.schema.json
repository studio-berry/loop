{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-berry.github.io/loupe/schemas/loupe-shell.schema.json",
  "title": "Loupe shell contract",
  "description": "Non-visual application-shell contract for issue #193.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "gui_status",
    "shell_surface",
    "ui_foundation",
    "workspaces",
    "state_invariants",
    "status_contract",
    "action_policy",
    "plugin_action_policy"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "issue": { "type": "integer", "const": 193 },
    "gui_status": { "type": "string", "const": "deferred-until-0.0.3" },
    "shell_surface": { "type": "string", "const": "Pdf4QtEditor" },
    "ui_foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "decision_issue", "decision_status"],
      "properties": {
        "candidate": { "type": "string", "const": "Qt Quick Controls" },
        "decision_issue": { "type": "integer", "const": 178 },
        "decision_status": { "type": "string", "enum": ["pending", "accepted", "rejected"] }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest_surface", "preserves"],
        "properties": {
          "id": { "type": "string", "enum": ["document", "preflight", "production-preview", "pages", "inspect", "fix", "compare"] },
          "manifest_surface": { "type": "string", "pattern": "^loupe-[a-z0-9-]+$" },
          "preserves": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "state_invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "status_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "production", "preflight"],
      "properties": {
        "document": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "production": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "preflight": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "action_policy": { "type": "string", "const": "docs/loupe-shell-actions.json" },
    "plugin_action_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "disposition", "target"],
        "properties": {
          "plugin": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["KEEP", "ADVANCED", "ABSORB", "HIDE", "OPEN", "STOP-SHIPPING"] },
          "target": { "enum": ["Document", "Preflight", "Production", "Inspect", "Fix", "Pages", "Compare", "Advanced"] }
        }
      }
    }
  }
}
