    "scheme": "semver",
    "tag_prefix": "v"
  },
  "workflow_branches": {
    ".github/workflows/ci.yml": [
      "dev",
      "stable"
    ],
    ".github/workflows/codeql.yml": [
      "dev",
      "stable"
    ],
    ".github/workflows/documentation.yml": [
      "dev",
      "stable"
    ],
    ".github/workflows/release-gate.yml": [
      "stable"
    ]
  }
}
