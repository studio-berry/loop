{
  "branch_policy": {
    "default": "stable",
    "integration": "dev",
    "protected": [
      "dev",
      "stable"
    ],
    "release": "stable",
    "topic_patterns": [
      "chore/*",
      "docs/*",
      "feature/*",
      "fix/*",
      "gh-*"
    ],
    "topic_source": "dev"
  },
  "format_version": 1,
  "generated_by": "scripts/generate-architecture-catalogs.py",
  "preflight_check_catalog": "docs/generated/preflight-check-catalog.json",
  "preflight_checks": [
    "bleed",
    "color-inventory",
    "color-mode",
    "content-bleed",
    "dieline",
    "embedded-fonts",
    "font-integrity",
    "hidden-layers",
    "image-resolution",
    "ink-coverage",
    "invisible-content",
    "obscured-content",
    "off-page-content",
    "output-intent",
    "page-size",
    "processing-steps",
    "thin-parts",
    "thin-strokes",
    "transparency-risk",
    "trim",
    "white-overprint"
  ],
  "registered_operations": [
    {
      "id": "add-bleed",
      "implementation": "Pdf4QtLibCore/sources/pdfrepairprimitives.cpp"
    },
    {
      "id": "downsample-images",
      "implementation": "Pdf4QtLibCore/sources/pdfrepairprimitives.cpp"
    },
    {
      "id": "production.add-contour-bleed",
      "implementation": "Pdf4QtLibCore/sources/pdfproductionrepair.cpp"
    },
    {
      "id": "production.place-grommets",
      "implementation": "Pdf4QtLibCore/sources/pdfproductionrepair.cpp"
    },
    {
      "id": "production.validate-wide-format",
      "implementation": "Pdf4QtLibCore/sources/pdfproductionrepair.cpp"
    },
    {
      "id": "rgb-to-cmyk",
      "implementation": "Pdf4QtLibCore/sources/pdfrepairprimitives.cpp"
    },
    {
      "id": "standards-convert",
      "implementation": "Pdf4QtLibCore/sources/pdfrepairprimitives.cpp"
    }
  ],
  "schema_kinds": [
    "action-list",
    "capability-discovery",
    "certificate",
    "evidence-graph",
    "history-db",
    "ocr-report",
    "operation-plan",
    "operation-result",
    "package-manifest",
    "pagemaster-manifest",
    "pdftool-envelope",
    "preflight-decisions",
    "preflight-profile",
    "preflight-report",
    "provenance-event"
  ],
  "schema_versions": {
    "json_schemas": {
      "loupe-preflight/schemas/action-list.schema.json": [],
      "loupe-preflight/schemas/profile.schema.json": [
        1
      ],
      "loupe-preflight/schemas/report.schema.json": [
        1,
        2,
        3
      ]
    },
    "runtime": {
      "action_list": 1,
      "preflight_decisions": 1,
      "preflight_report": 3
    }
  },
  "sources": [
    "docs/branch-policy.json",
    "docs/version-policy.json",
    "Pdf4QtLibCore/sources/preflightengine.cpp",
    "Pdf4QtLibCore/sources/preflightengine.h",
    "docs/preflight-check-catalog-overlay.json",
    "Pdf4QtLibCore/sources/pdfactionlist.cpp",
    "Pdf4QtLibCore/sources/pdfrepairoperation.cpp",
    "Pdf4QtLibCore/sources/pdfrepairprimitives.cpp",
    "Pdf4QtLibCore/sources/pdfproductionrepair.cpp",
    "loupe-preflight/schemas/*.json",
    "Pdf4QtLibCore/sources/pdfschemaversion.cpp",
    "UnitTests/CMakeLists.txt",
    ".github/workflows/*.yml"
  ],
  "test_targets": [
