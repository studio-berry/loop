<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define MyInstallDir="${WIX_INSTALL_PREFIX}" ?>

  <Product Id="*" Name="Loupe" Language="1033" Version="${LOUPE_VERSION}" Manufacturer="Michael Berry" UpgradeCode="26336d8a-b2e7-44fc-9a73-68aa99900c7a">
    <Package Id="*" InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Manufacturer="Michael Berry" Keywords="pdf,production,cli" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Loupe is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <WixVariable Id="WixUILicenseRtf" Value="explic.rtf" />

    <Feature Id="feature_LOUPE_Framework" Title="Loupe" Level="1" ConfigurableDirectory="INSTALLFOLDER" Absent="disallow" AllowAdvertise="no" Display="expand" Description="Loupe desktop, Loupe CLI, and shared PDF services.">
      <ComponentGroupRef Id="LOUPE_Framework" />
      <ComponentRef Id="ProgramMenuDir" />

      <Feature Id="feature_LOUPE_Editor" Absent="allow" AllowAdvertise="no" Title="Editor"  Display="expand" Level="1" Description="LoupeEditor Quick shell for interactive PDF inspection and preparation.">
        <ComponentGroupRef Id="LOUPE_Editor"/>
${LOUPE_WIX_EDITOR_DATA_REF}
${LOUPE_WIX_FEATURE_OCR_SERVICE}
      </Feature>
    </Feature>

    <UIRef Id="WixUI_FeatureTree" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="LOUPE" />
        <Directory Id="dir_share_root" Name="share">
          <Directory Id="dir_loupe" Name="loupe">
            <Directory Id="dir_loupe_profiles" Name="profiles">
              <Directory Id="dir_loupe_schemas" Name="schemas" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop"/>
      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="Loupe">
          <Component Id="ProgramMenuDir" Guid="{33A118A2-C455-45C1-9E0C-710750A71335}">
            <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKMU" Key="Software\[Manufacturer]\[ProductName]" Type="string" Value="" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
