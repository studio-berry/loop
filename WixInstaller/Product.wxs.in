<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Loop" Language="1033" Version="${LOOP_VERSION}" Manufacturer="Michael Berry" UpgradeCode="26336d8a-b2e7-44fc-9a73-68aa99900c7a">
    <Package Id="*" Platform="x64" InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Manufacturer="Michael Berry" Keywords="pdf,production,cli" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Loop is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="feature_LOOP" Title="Loop" Level="1" ConfigurableDirectory="INSTALLFOLDER" Absent="disallow" AllowAdvertise="no">
      <!-- Generated from cmake --install immediately before candle/light. -->
      <ComponentGroupRef Id="LOOP_InstalledTree" />
    </Feature>
  </Product>
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="LOOP" />
      </Directory>
    </Directory>
  </Fragment>
  <!-- Stable product component identities retained for upgrade and graph
       validation. The installed-tree harvest supplies the files at package
       time; this group is intentionally not feature-referenced. -->
  <!-- Optional legacy substitutions remain named for the release contract:
       LOOP_WIX_QT_WIDGETS_COMPONENT, LOOP_WIX_QT_PRINTSUPPORT_COMPONENT,
       LOOP_WIX_QT_PRINTSUPPORT_DIRECTORY, LOOP_WIX_QT_STYLES_COMPONENT,
       LOOP_WIX_QT_STYLES_DIRECTORY. They are empty for the Quick product. -->
  <Fragment>
    <ComponentGroup Id="LOOP_ProductComponents">
      <Component Id="cmpLoopEditor" Directory="INSTALLFOLDER" Guid="{5F0A0F8A-2B2E-4E7F-9B7E-1E7E9C0A1D01}"><CreateFolder /></Component>
      <Component Id="cmpPdfTool" Directory="INSTALLFOLDER" Guid="{5F0A0F8A-2B2E-4E7F-9B7E-1E7E9C0A1D02}"><CreateFolder /></Component>
      <Component Id="cmpLoopLibCore" Directory="INSTALLFOLDER" Guid="{5F0A0F8A-2B2E-4E7F-9B7E-1E7E9C0A1D03}"><CreateFolder /></Component>
      <Component Id="cmpLoopLibQuick" Directory="INSTALLFOLDER" Guid="{5F0A0F8A-2B2E-4E7F-9B7E-1E7E9C0A1D04}"><CreateFolder /></Component>
    </ComponentGroup>
  </Fragment>
</Wix>
