{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loop.local/schemas/action-list-v2.schema.json",
  "title": "Loop Action List v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "steps"],
  "properties": {
    "schema": { "const": "loop-action-list/2" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "onFailure": { "enum": ["stop", "continue"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "params"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "params": { "type": "object" },
        "select": { "$ref": "../object-selector.schema.json" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "findingExists": { "type": "string", "minLength": 1 },
            "previousStepStatus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step", "status"],
              "properties": {
                "step": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pending", "running", "succeeded", "skipped", "failed", "cancelled"] }
              }
            }
          }
        },
        "onFailure": { "enum": ["stop", "continue"] }
      }
    }
  }
}
