{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-bash.py\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/cc-guard-bash.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-bash.py\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/cc-guard-write.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-bash.py\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/cc-format-cpp.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-bash.py\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-policy.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/run-bash.py\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/cc-stop-self-review.sh\""
          }
        ]
      }
    ]
  }
}
